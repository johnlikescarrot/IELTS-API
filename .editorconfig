root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# Ordered-list hanging indents are 3 spaces; Prettier owns Markdown indentation.
indent_size = unset

[data/**.json]
insert_final_newline = true

[*.py]
indent_size = 4

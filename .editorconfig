root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# Numbered-list continuations need three spaces; Markdown/Prettier own indentation.
indent_size = unset

[data/**.json]
insert_final_newline = true

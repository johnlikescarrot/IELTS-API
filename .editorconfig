root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Ordered-list continuation indentation is syntax-dependent (often 3 spaces).
# Prettier and Markdownlint enforce Markdown indentation, not a fixed modulus.
[*.md]
indent_size = unset
trim_trailing_whitespace = false

[data/**.json]
insert_final_newline = true

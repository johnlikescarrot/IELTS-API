# Super-Linter configuration: https://github.com/super-linter/super-linter
FILTER_REGEX_EXCLUDE=^(dist|coverage)/.*
JAVASCRIPT_DEFAULT_STYLE=prettier
TYPESCRIPT_DEFAULT_STYLE=prettier
# This repository runs ESLint + Prettier and its own security/lint steps in
# the main CI workflow. Super-Linter stays focused on repository formatting,
# enabling the checks that are most useful here and disabling validators that
# need project-specific tooling or produce noise on this codebase.
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
VALIDATE_CHECKOV=false
VALIDATE_ENV=false
VALIDATE_GITHUB_ACTIONS_ZIZMOR=false
VALIDATE_JSCPD=false
VALIDATE_MARKDOWN=false
VALIDATE_NATURAL_LANGUAGE=false
VALIDATE_JSON=false
VALIDATE_TRIVY=false
VALIDATE_TYPESCRIPT_ES=false
VALIDATE_TYPESCRIPT_PRETTIER=false
VALIDATE_TYPOS=false
VALIDATE_ACTIONLINT=false
VALIDATE_GITLEAKS=false
VALIDATE_YAML=false

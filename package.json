{
  "name": "ielts-api",
  "version": "1.0.0",
  "description": "A free, open, no-authentication REST API for IELTS study data: vocabulary, speaking topics, writing prompts, common mistakes, band descriptors and a band-score calculator. Zero runtime dependencies.",
  "type": "module",
  "main": "dist/server.js",
  "license": "MIT",
  "keywords": [
    "ielts",
    "esl",
    "efl",
    "vocabulary",
    "english",
    "rest-api",
    "open-data",
    "education"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlikescarrot/IELTS-API.git"
  },
  "bugs": {
    "url": "https://github.com/johnlikescarrot/IELTS-API/issues"
  },
  "homepage": "https://github.com/johnlikescarrot/IELTS-API#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}

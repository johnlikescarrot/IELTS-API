{
  "name": "ielts-api",
  "version": "1.0.0",
  "description": "A free, authentication-free IELTS practice API.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "check": "npm run build && npm test"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "@hono/node-server": "^1.19.0", "hono": "^4.9.0" },
  "devDependencies": { "@vitest/coverage-v8": "^3.2.4", "@types/node": "^22.0.0", "eslint": "^9.0.0", "tsx": "^4.19.0", "typescript": "^5.8.0", "vitest": "^3.2.4" }
}

{
  "name": "ielts-api",
  "version": "1.0.0",
  "description": "A free, no-authentication TypeScript REST API for IELTS preparation research: vocabulary, bands, scoring, task banks and reproducible Reading/Listening practice metadata.",
  "keywords": [
    "ielts",
    "api",
    "education",
    "nlp",
    "vocabulary",
    "assessment",
    "second-language-acquisition",
    "open-data",
    "typescript",
    "reading",
    "listening",
    "reproducibility"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ielts-api": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "CITATION.cff",
    "LICENSE",
    "DATA-LICENSE",
    "codemeta.json",
    "RESEARCH.md",
    "docs/openapi.json",
    "docs/PRACTICE.md",
    "docs/RESEARCH-WORKFLOW.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "data:vocabulary": "python3 scripts/extract_vocabulary.py",
    "data:corpus": "python3 scripts/extract_corpus.py",
    "data:practice": "tsx scripts/extract_practice.ts",
    "openapi:generate": "tsx scripts/generate_openapi.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlikescarrot/IELTS-API.git"
  },
  "publishConfig": {
    "access": "public"
  }
}

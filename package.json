{
  "name": "ielts-api",
  "version": "1.0.0",
  "description": "A free, authentication-free, dependency-free, fully reproducible IELTS scoring and language-assessment API and reference library written in TypeScript.",
  "keywords": [
    "ielts",
    "api",
    "language-assessment",
    "band-score",
    "cefr",
    "academic-word-list",
    "readability",
    "open-science",
    "reproducible-research",
    "typescript"
  ],
  "homepage": "https://github.com/johnlikescarrot/IELTS-API#readme",
  "bugs": {
    "url": "https://github.com/johnlikescarrot/IELTS-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlikescarrot/IELTS-API.git"
  },
  "license": "MIT",
  "author": "IELTS-API Contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ielts-api": "./dist/bin/serve.js"
  },
  "files": [
    "dist",
    "openapi.json",
    "CITATION.cff"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('dist',{recursive:true,force:true});rmSync('coverage',{recursive:true,force:true})\"",
    "dev": "node --experimental-strip-types src/bin/serve.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "openapi:emit": "npm run build && node scripts/emit-openapi.mjs",
    "start": "node dist/bin/serve.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "determinism": "npm run build && node scripts/check-determinism.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "ielts-api",
  "version": "1.4.0",
  "description": "A free, open, no-authentication REST API for IELTS preparation research: Cambridge IELTS 1-22 vocabulary, band descriptors, score conversion, task and topic banks, a canonical question-type taxonomy, a structure and readability index of 1,702 practice tests and a grey-literature archive index of the Cambridge 1-18 listening audio, the official sample tasks and marked learner essays, and a mock exam centre: test-day rulebook, countdown schedule, raw-score conversion tables, score reports and a deterministic mock-paper composer.",
  "keywords": [
    "ielts",
    "api",
    "education",
    "nlp",
    "vocabulary",
    "assessment",
    "second-language-acquisition",
    "open-data",
    "typescript",
    "readability",
    "question-types",
    "language-testing",
    "learner-corpus",
    "grey-literature",
    "listening-comprehension",
    "mock-exam",
    "raw-score-conversion"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ielts-api": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "CITATION.cff",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "data:vocabulary": "python3 scripts/extract_vocabulary.py",
    "data:corpus": "python3 scripts/extract_corpus.py",
    "data:practice-tests": "python3 scripts/extract_practice_tests.py",
    "data:materials": "python3 scripts/extract_materials.py",
    "data:archive": "python3 scripts/extract_archive.py"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlikescarrot/IELTS-API.git"
  },
  "publishConfig": {
    "access": "public"
  }
}

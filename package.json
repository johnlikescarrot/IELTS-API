{
  "name": "ielts-api",
  "version": "0.1.0",
  "description": "A free, open, no-authentication REST API for IELTS study materials and tooling, written in TypeScript.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run build && npm run test:coverage",
    "ci": "npm run format:check && npm run lint && npm run build && npm run test:coverage"
  },
  "keywords": [
    "ielts",
    "api",
    "study",
    "band-score",
    "writing",
    "speaking",
    "reading",
    "listening",
    "vocabulary",
    "rest",
    "typescript",
    "free",
    "no-auth",
    "open"
  ],
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}

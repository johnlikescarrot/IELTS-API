{
  "name": "ielts-api",
  "version": "1.0.0",
  "description": "The best free, no-authentication IELTS preparation API ever written in TypeScript: Academic Word List vocabulary, question banks, official band descriptors, score conversion, practice tests, common-mistake drills, and study plans.",
  "keywords": [
    "ielts",
    "english",
    "vocabulary",
    "academic-word-list",
    "awl",
    "band-descriptors",
    "question-bank",
    "practice",
    "api",
    "rest",
    "fastify",
    "typescript"
  ],
  "homepage": "https://github.com/johnlikescarrot/IELTS-API#readme",
  "bugs": {
    "url": "https://github.com/johnlikescarrot/IELTS-API/issues"
  },
  "license": "MIT",
  "author": "johnlikescarrot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlikescarrot/IELTS-API.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "bin": {
    "ielts-api": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:markdown": "markdownlint -c .markdown-lint.yml --ignore node_modules \"**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^8.57.1",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.5.4",
    "vitest": "^3.0.5"
  }
}

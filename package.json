{
  "name": "ielts-api",
  "version": "1.0.0",
  "description": "A free, open, no-authentication IELTS study API written in TypeScript: band-scored vocabulary, reading and listening practice tests, writing tasks with model answers, common writing mistakes, a speaking question bank, band-score tools, and exam tips.",
  "keywords": [
    "ielts",
    "api",
    "typescript",
    "rest",
    "education",
    "esl",
    "vocabulary",
    "english",
    "open-data",
    "no-auth",
    "free"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src tests --ext .ts && prettier --check . && markdownlint --config .markdown-lint.json \"*.md\" \"docs/**/*.md\" \".github/**/*.md\"",
    "format": "prettier --write . && eslint src tests --ext .ts --fix",
    "test": "node --import tsx --test --test-force-exit \"tests/*.test.ts\"",
    "test:coverage": "c8 npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlikescarrot/IELTS-API.git"
  },
  "bugs": {
    "url": "https://github.com/johnlikescarrot/IELTS-API/issues"
  },
  "homepage": "https://github.com/johnlikescarrot/IELTS-API#readme",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
